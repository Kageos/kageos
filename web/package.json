{
  "name": "kageos-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "run-s check:architecture && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:login": "E2E_SKIP_AUTH_SETUP=1 playwright test tests/e2e/login-page.spec.ts --project chromium-public",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --project chromium",
    "test:e2e:workspace-nav": "playwright test tests/e2e/workspace-navigation.spec.ts --project chromium",
    "test:e2e:service-tree": "playwright test tests/e2e/service-tree-actions.spec.ts --project chromium",
    "test:e2e:workstation": "playwright test tests/e2e/workstation-open.spec.ts --project chromium",
    "test:e2e:workstation-compose": "playwright test tests/e2e/workstation-composer.spec.ts --project chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "audit:i18n": "node scripts/audit-i18n-hardcoded.mjs",
    "audit:i18n:strict": "node scripts/audit-i18n-hardcoded.mjs --fail-on-findings",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "playwright:install": "playwright install chromium",
    "playwright:mcp": "npx -y @playwright/mcp@latest --config ./tests/e2e/playwright.mcp.persistent.config.json",
    "playwright:mcp:isolated": "npx -y @playwright/mcp@latest --config ./tests/e2e/playwright.mcp.isolated.config.json",
    "playwright:mcp:http": "npx -y @playwright/mcp@latest --config ./tests/e2e/playwright.mcp.persistent.config.json --port 8931"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@monaco-editor/loader": "^1.7.0",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-dropcursor": "^3.31.3",
    "@tiptap/extension-focus": "^3.31.3",
    "@tiptap/extension-gapcursor": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-history": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.11.0",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "js-sha256": "^1.0.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.12",
    "md-editor-v3": "^6.5.6",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinyin-pro": "^3.29.3",
    "prosemirror-transform": "^1.12.1",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.4",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.0",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.104.0",
    "typescript": "~7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "exceljs": {
      "archiver": "8.0.0",
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    },
    "dompurify": "3.4.13",
    "linkify-it": "5.0.2",
    "postcss": {
      ".": "8.5.23",
      "nanoid": "3.3.18"
    }
  }
}
